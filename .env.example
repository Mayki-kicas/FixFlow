POSTGRES_USER=maintenance
POSTGRES_PASSWORD=maintenance
POSTGRES_DB=maintenance
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://maintenance:maintenance@db:5432/maintenance

# Next.js
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production
NEXTAUTH_URL=http://localhost:3000
DEV_AUTH_BYPASS=false
NEXT_PUBLIC_DEV_AUTH_BYPASS=false

# Amorçage admin : ces emails sont promus ADMIN (actif) à la 1re connexion SSO.
# Indispensable au démarrage, car les rôles ne viennent plus des groupes AD.
BOOTSTRAP_ADMIN_EMAILS=
# Mot de passe de l'admin local créé au seed (break-glass). À changer.
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-admin-123
# Leave empty to disable host allowlist check, or set comma-separated hosts:
# ALLOWED_HOSTS=fixflow.example.com,www.fixflow.example.com
ALLOWED_HOSTS=
FORCE_HTTPS=false
SECURITY_LOGIN_WINDOW_MS=600000
SECURITY_LOGIN_MAX_ATTEMPTS=8
ATTACHMENT_MAX_BYTES=8388608
CHAT_ATTACHMENTS_MAX_FILES=5
TICKET_ATTACHMENTS_MAX_FILES=5
# Stockage des pièces jointes (hors base). Driver disque local par défaut.
# En prod (systemd), pointer vers un dossier persistant sauvegardé, ex: /opt/fixflow/shared/uploads
STORAGE_LOCAL_DIR=/app/uploads

# Plans d'étage (rubrique Plans). Taille max d'un plan uploadé.
FLOOR_PLAN_MAX_BYTES=26214400
# URL du service de conversion DWG -> SVG. En Docker : http://dwg-converter:8000.
# Laisser vide désactive la conversion DWG (upload SVG/PDF/PNG toujours possible).
DWG_CONVERTER_URL=http://dwg-converter:8000

# LDAP Configuration
LDAP_URL=ldap://your-ldap-server:389
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=your-ldap-password
LDAP_SEARCH_BASE=ou=users,dc=example,dc=com
LDAP_USERNAME_ATTRIBUTE=uid
# Set to false for self-signed LDAPS certificates in dev only
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_USER_LIST_FILTER=(&(objectClass=person)(!(objectClass=computer)))
LDAP_IMPORT_LIMIT=1000

# NB: les rôles ne sont PLUS dérivés des groupes AD à la connexion — ils sont gérés
# dans le backoffice (Utilisateurs & rôles). Ces variables ne servent qu'aux
# SUGGESTIONS de rôle lors de l'import LDAP manuel.
LDAP_ROLE_OU=TicketsMaintenance
LDAP_GROUP_ADMIN=Admin
LDAP_GROUP_MANAGER=Manager
LDAP_GROUP_BASIC=Basic

# Microsoft Entra ID (SSO OAuth) — activé depuis le backoffice (Authentification).
# Tenant ID et Client ID se saisissent dans l'UI ; SEUL le secret vit ici.
# Redirect URI à déclarer côté Azure : <NEXTAUTH_URL>/api/auth/callback/azure-ad
ENTRA_CLIENT_SECRET=

# Email notifications (dev local catcher: Mailpit)
EMAIL_NOTIFICATIONS_ENABLED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=FixFlow <noreply@fixflow.local>
SMTP_TIMEOUT_MS=10000

# Jobs cron internes (file d'emails + rappels d'échéance).
# Secret partagé entre les timers systemd et les endpoints /api/notifications/*.
# Générer une valeur forte en prod: openssl rand -hex 32
INTERNAL_CRON_TOKEN=change-me-internal-cron-token

# Cadence des relances devis au prestataire (jours) si pas de devis reçu dans le SLA.
QUOTE_REMINDER_INTERVAL_DAYS=2

# Intégration app mainteneur externe (dispatch + feedback).
INTEGRATION_SHARED_TOKEN=change-me-integration-token
# Secret de signature HMAC (H2), DISTINCT du token ci-dessus. Signe/vérifie le
# corps des échanges (dispatch sortant + feedback entrant). Tant que vide, la
# signature n'est pas imposée (rétro-compat avant branchement de l'app externe).
# Générer une valeur forte en prod: openssl rand -hex 32
INTEGRATION_SIGNING_SECRET=
# EXTERNAL_MAINTAINER_API_URL=https://maintainer.example.com
